# ============================================
# TABLETRAIL PRODUCTION ENVIRONMENT TEMPLATE
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env.prod.local (DO NOT commit)
# 2. Fill in your actual API keys and secrets
# 3. Add to .gitignore if not already there
# 4. Never paste this file in chat or version control
# 5. Store actual .env.prod.local in your password manager
#
# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://tabletrail:[REDACTED]@postgres:5432/tabletrail
# For local testing: postgresql://tabletrail:[REDACTED]@localhost:5432/tabletrail
# For Vercel: use Environment Variables UI (not in git)

# ============================================
# REDIS (Order events, caching)
# ============================================
REDIS_URL=redis://redis:6379
# For Vercel: integrate Redis provider (e.g., Upstash) via env var

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://tabletrail.co.in
# Set to your domain once deployed
# Format: https://your-domain.com (with https://)

NEXT_TELEMETRY_DISABLED=1

# ============================================
# AUTHENTICATION & SESSIONS
# ============================================
AUTH_PROVIDER=postgres
# Options: "postgres" (production) | "development" (local testing)

SESSION_SECRET=605936a0cabe4b808ffee91510f009ea
# Generate: openssl rand -base64 32
# Keep SECRET—rotation requires DB migration
# WARNING: Changing this invalidates all active sessions

# ============================================
# PAYMENT GATEWAY (NOT IMPLEMENTED)
# ============================================
# The repository currently ships only a test payment provider.
# Do not set a live provider here until checkout and webhook integration is implemented and verified.
PAYMENT_PROVIDER=test
PAYMENT_SECRET=

# ============================================
# SMS (OTP DELIVERY, NOT VERIFIED)
# ============================================
SMS_PROVIDER=log
# Fast2SMS adapter code exists but has not been verified against a provider sandbox.

SMS_API_KEY=YOUR_FAST2SMS_API_KEY
# From Fast2SMS Dashboard > API Keys
# Looks like: [redacted]...keep private

SMS_SENDER_ID=TABLETRAIL
# Your registered sender ID on Fast2SMS (max 6 chars)
# Must be pre-approved by Fast2SMS

# ============================================
# MAPS (ADAPTER, NOT VERIFIED)
# ============================================
# The repository includes a Mapbox adapter, but it is not verified for production.
MAPS_PROVIDER=mock
# Options: "mapbox" | "google" | "mock" (dev only)

MAPS_API_KEY=YOUR_MAPBOX_PUBLIC_TOKEN
# From Mapbox Dashboard > Tokens
# Public token (pk_live_xxxxx) is safe to expose
# Rate-limited per domain

# ============================================
# EMAIL (ORDER CONFIRMATIONS) — OPTIONAL
# ============================================
EMAIL_PROVIDER=log
# Options: "sendgrid" | "mailgun" | "aws-ses" | "log" (dev only)
# If using "log", emails printed to stdout
# If production: set to "sendgrid" or similar

EMAIL_API_KEY=
# Only needed if EMAIL_PROVIDER != "log"

# ============================================
# PARTNER PORTAL
# ============================================
PARTNER_PORTAL=postgres
# Options: "postgres" (production) | "development" (in-memory)

# ============================================
# ORDER STORAGE
# ============================================
ORDER_STORE=postgres
# Options: "postgres" (production) | "memory" (dev only)
# CRITICAL: Must be "postgres" in production
# "memory" = data lost on restart

# ============================================
# ADMIN PANEL
# ============================================
ADMIN_PHONE=+919876543210
# Phone number of initial admin (set before db:seed)
# After seeding, login via OTP and manage roles in admin panel

# ============================================
# MONITORING & METRICS
# ============================================
METRICS_TOKEN=7193632c41dc4da890ac29d799f9baec
# Bearer token for Prometheus endpoint: /api/metrics
# Generate: openssl rand -hex 32
# Usage: curl -H "Authorization: Bearer METRICS_TOKEN" https://tabletrail.co.in/api/metrics

# ============================================
# OPTIONAL: FOR ADVANCED SETUP
# ============================================

# Sentry.io error tracking (optional)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# DataDog / NewRelic APM (optional)
# APM_ENDPOINT=

# LogRocket session replay (optional, client-side)
# NEXT_PUBLIC_LOGROCKET_ID=
