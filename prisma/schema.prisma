generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  CONFIRMED
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  ASSIGNED
  DELIVERING
  DELIVERED
}

enum UserRole {
  CUSTOMER
  PARTNER
  ADMIN
  DELIVERY
}

enum PaymentStatus {
  INITIATED
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
}

enum NotificationType {
  ORDER_CREATED
  ORDER_CONFIRMED
  ORDER_CANCELLED
  RESTAURANT_ACCEPTED
  FOOD_PREPARING
  FOOD_READY
  COURIER_ASSIGNED
  DELIVERY_STARTED
  DELIVERY_COMPLETED
  DELIVERY_DELAYED
}

model User {
  id        String    @id @default(cuid())
  name      String
  phone     String?   @unique
  email     String?   @unique
  role      UserRole  @default(CUSTOMER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  addresses Address[]
  orders    Order[]   @relation("CustomerOrders")
  sessions  Session[]
  restaurants Restaurant[]
  deliveries Order[] @relation("DeliveryOrders")
  auditLogs  AuditLog[]
  notifications Notification[]
}

model OtpChallenge {
  id         String   @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  @@index([phone, expiresAt])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String
  line      String
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([userId])
}

model Restaurant {
  id              String     @id
  name            String
  description     String
  rating          Decimal    @db.Decimal(2, 1)
  reviewCount     Int        @default(0)
  deliveryMinutes Int
  deliveryFee     Int
  priceForTwo     Int
  vegetarian      Boolean    @default(false)
  open            Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  ownerId          String?
  menuItems       MenuItem[]
  orders          Order[]
  owner            User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
}

model MenuItem {
  id           String      @id
  restaurantId String
  category     String
  name         String
  description  String
  price        Int
  vegetarian   Boolean     @default(false)
  available    Boolean     @default(true)
  inventoryCount Int?
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@index([restaurantId, available])
}

model Order {
  id             String            @id @default(cuid())
  userId         String?
  restaurantId   String
  addressId      String?
  status         OrderStatus       @default(CONFIRMED)
  deliveryStatus DeliveryStatus    @default(PENDING)
  subtotal       Int
  deliveryFee    Int
  serviceFee     Int
  total          Int
  currency       String            @default("INR")
  notes          String?
  deliveryPartnerId String?
  assignedAt     DateTime?
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
  estimatedDeliveryAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User?             @relation("CustomerOrders", fields: [userId], references: [id], onDelete: SetNull)
  deliveryPartner User?            @relation("DeliveryOrders", fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  restaurant     Restaurant        @relation(fields: [restaurantId], references: [id])
  address        Address?          @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  idempotencyKey OrderIdempotency?
  paymentAttempts PaymentAttempt[]
  deliveryEvents DeliveryEvent[]
  outboxEvents   OutboxEvent[]
  notifications  Notification[]

  @@index([restaurantId, status, deliveryStatus])
  @@index([createdAt])
  @@index([deliveryPartnerId, status])
  @@index([deliveryStatus, updatedAt])
}

model PaymentAttempt {
  id                 String        @id @default(cuid())
  orderId            String
  attemptNo          Int
  provider           String
  providerReference  String?
  amount             Int
  currency           String        @default("INR")
  status             PaymentStatus @default(INITIATED)
  idempotencyKey     String        @unique
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events             PaymentEvent[]
  refunds            Refund[]

  @@unique([orderId, attemptNo])
  @@index([status, updatedAt])
}

model PaymentEvent {
  id                String         @id @default(cuid())
  providerEventId   String         @unique
  paymentAttemptId  String
  eventType         String
  payloadHash       String
  receivedAt        DateTime       @default(now())
  appliedAt         DateTime?
  paymentAttempt    PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)

  @@index([paymentAttemptId, receivedAt])
}

model Refund {
  id                String         @id @default(cuid())
  paymentAttemptId  String
  amount            Int
  reason            String
  status            PaymentStatus  @default(REFUND_PENDING)
  providerReference String?
  idempotencyKey    String         @unique
  createdAt         DateTime       @default(now())
  settledAt         DateTime?
  paymentAttempt    PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  name       String
  unitPrice  Int
  quantity   Int
  currency   String   @default("INR")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
}

model OrderIdempotency {
  key       String   @id
  orderId   String   @unique
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model DeliveryEvent {
  id               String           @id @default(cuid())
  orderId          String
  status           DeliveryStatus
  assignedCourierId String?
  reason           String?
  createdAt        DateTime         @default(now())
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model OutboxEvent {
  id        String   @id @default(cuid())
  orderId   String
  eventType String   // ORDER_STATUS_CHANGED, DELIVERY_ASSIGNED, etc.
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
  processedAt DateTime?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, processed])
  @@index([processed, createdAt])
}

model Notification {
  id                String           @id @default(cuid())
  userId            String
  orderId           String
  type              NotificationType
  title             String
  message           String
  data              Json?
  read              Boolean          @default(false)
  readAt            DateTime?
  channels          String[] @default([])  // "inbox", "email", "sms", "push"
  sentAt            DateTime?
  deliveredAt       DateTime?
  failureCount      Int              @default(0)
  lastError         String?
  createdAt         DateTime         @default(now())
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([orderId, createdAt])
  @@index([sentAt, deliveredAt])
}
